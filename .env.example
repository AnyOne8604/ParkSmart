# Copia este archivo a .env y sustituye todos los valores de ejemplo antes de iniciar Docker.
# Acceso de la base y secreto para firmar JWT; no publiques credenciales reales ni el .env.
POSTGRES_PASSWORD=change-me-for-local-use
JWT_SECRET=generate-a-long-random-secret
CORS_ORIGINS=http://localhost:8000
# Cuenta administrativa inicial creada/sincronizada por FastAPI al arrancar (rol admin desde v0.5.0).
ADMIN_NAME=Carlos Ramírez
ADMIN_EMAIL=movilidad@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Credenciales separadas para entrar a la interfaz pgAdmin local.
PGADMIN_DEFAULT_EMAIL=admin@parksmart.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
